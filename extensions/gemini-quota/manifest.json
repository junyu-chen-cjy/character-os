{
  "manifest_version": 3,
  "name": "Character OS · Gemini Quota",
  "version": "0.1.0",
  "key": "",
  "permissions": [
    "alarms",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://gemini.google.com/usage*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Refresh Gemini quota"
  }
}
